# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (supabase.com/dashboard → projeto → Project Settings → API).
# Use só a chave pública "anon". Nunca coloque aqui a chave "service_role".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
