# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (supabase.com/dashboard → projeto → Project Settings → API).
# Use só a chave pública "anon". Nunca coloque aqui a chave "service_role".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui

# Google Maps (Maps JavaScript API): Street View próprio na aba /rua.
# Restrinja a chave no Google Cloud ao endereço do site e só à Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=cole-a-chave-do-google-aqui

# Discador por QR Code (/telefone). Dados do ramal (Método/VoiceManager) — SÓ no servidor (Vercel),
# nunca no navegador. TELEFONE_TOKEN é o código secreto que vai no link do QR; sem ele a rota não
# entrega nada. Pode ter vários tokens separados por vírgula. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RAMAL_DOMINIO=metodotelecom.com.br
RAMAL_WSS=wss://servidor-voip:5069/ws
RAMAL_LOGIN=numero-do-ramal
# Se a senha tiver # ou espaço, ponha entre aspas no .env.local. Na Vercel, cole sem aspas.
RAMAL_SENHA=senha-do-ramal
TELEFONE_TOKEN=cole-um-token-aleatorio-aqui
